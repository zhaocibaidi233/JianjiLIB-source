{
  "name": "jianji-frontend",
  "private": true,
  "version": "1.1.28",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:types": "openapi-typescript ../backend/openapi.json -o src/lib/api-types.ts",
    "gen:openapi": "cd ../backend && .venv/Scripts/python.exe -c \"import json;from app.main import app;open('openapi.json','w',encoding='utf-8').write(json.dumps(app.openapi(),ensure_ascii=False,indent=1))\""
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.1",
    "axios": "^1.7.9",
    "element-plus": "2.14.7",
    "jsbarcode": "^3.12.3",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^6.0.7",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
